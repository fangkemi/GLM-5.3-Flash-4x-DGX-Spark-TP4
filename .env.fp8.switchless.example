# Example based on the verified dealignai FP8 deployment. Adjust paths, addresses,
# image and NCCL identity for your fleet; use fresh runtime names on every deployment.
# Verified physical ring: spark1 -> spark2 -> spark4 -> sparkX -> spark1.
# This FP8 target has no DFlash2 drafter. Its attention projections include
# BF16 weights, so keep the NVFP4-attention patch disabled.
HOSTS="spark1.local spark2.local spark4.local sparkx.local"
SSH_OPTS="-4 -o BatchMode=yes"
IPS="192.168.31.115 192.168.31.175 192.168.31.23 192.168.31.57"
FABRIC_IFACE=wlP9s9
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_HOST_DIR=/home/kemi/nccl-2.30.7
SWITCHLESS_NCCL_SHA256=c9b93d38e72931a51d0e3f5da68f6beec5b175fde607e773aa08b2eebeaadb03
SWITCHLESS_ADDR_RANGE=10.100.224.0/22
SWITCHLESS_SUBNET_PREFIX_LEN=24
TRANSPORT=switchless
IMAGE=glm53-roce:v11-b58f34ea
MODEL_DIR=/home/kemi/models/dealignai/GLM-5.3-Flash-UNCENSORED-FP8
CTN=glm53-fp8-run01
OVERLAY_REMOTE=/home/kemi/glm53-fp8-run01
SERVED_NAME=glm-5.3-flash
MAX_MODEL_LEN=1048576
KV_DTYPE=auto
# 17 GiB per rank; 19 GiB boot reported 1,716,056 KV tokens, so expect ~1.535M total.
KV_BYTES=18253611008
MAX_SEQS=3
BATCHED_TOKENS=4096
K_HI=1
K_LO=1
SPEC_DISABLE=1
SCHEDULER_CLS=none
CAPTURE_SIZES='[1,2,4,8,16,32]'
CAPTURE_MAX=32
MOE_BACKEND=triton
DEFAULT_EFFORT=low
HOST_BIND=0.0.0.0
PORT=8888
GPU_UTIL=0.85
MM_IMAGES=32
MM_CACHE_GB=2
GLM5NEXT_PATCH=0
GLM_KPOOL_FIX=0
GLM_ARGMAX_CLAMP=0
LOAD_FORMAT=
PREWARM=0
BOOT_WARM=0
COMPACT_MEM=0
FI_CACHE_PERSIST=1
EXTRA_ENV="GLM_MAMBA_ALIGN_FIX=1"
EXTRA_ARGS='--linear-backend triton'
