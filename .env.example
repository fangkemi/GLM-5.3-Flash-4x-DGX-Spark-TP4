# Hardware and paths for your four Sparks; the serving semantics come from profiles/production.env (sourced last).
# ssh aliases and fabric IPs, rank 0 first (the head, API on HOST_BIND:PORT)
HOSTS="Spark_01 Spark_02 Spark_03 Spark_04"
SSH_OPTS=""
IPS="10.100.96.2 10.100.96.1 10.100.96.3 10.100.96.4"
FABRIC_IFACE=enp1s0f0np0
IB_HCA=rocep1s0f0,roceP2p1s0f0     # both ConnectX-7 rails; one HCA name for a single rail
NCCL_IB_GID_INDEX=3
# NCCL 2.30.7 built for the host; leave empty to use the image's NCCL
NCCL_HOST_DIR=/home/knapcio/nccl-2.30.7
# Built from docker/Dockerfile.roce on every node (README, "Build")
IMAGE=glm53-roce:v11-b58f34ea
# Weights, present on every node at the same path (README, "Weights")
MODEL_DIR=/home/knapcio/models/glm-quant-mix/lossless8
DRAFT_DIR=/home/knapcio/models/incoai/GLM-5.3-Flash-DFlash2-fp8blk
CTN=glm53
OVERLAY_REMOTE=/home/knapcio/glm53-flash-4x-spark   # where the launcher copies overlay/, scripts/, bench/ on each node
source profiles/production.env
